# CivicPulse Configuration Example
# Copy this file to .env and customize for your local setup.
# NEVER commit .env to version control!

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_secret_pw
POSTGRES_DB=civicpulse_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse_secret_pw@postgres:5432/civicpulse_db
# Sync DB URL for Alembic migrations if needed
SYNC_DATABASE_URL=postgresql://civicpulse:civicpulse_secret_pw@postgres:5432/civicpulse_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache TTLs (in seconds)
STATS_CACHE_TTL_SECONDS=30
TRIAGE_CACHE_TTL_SECONDS=86400

# AI Triage Provider Configuration
# Allowed options: llm, ollama, rules, simulated
TRIAGE_PROVIDER=simulated

# Hosted LLM Provider (e.g., Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Provider (Offline)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Docker Image Tag (Used in compose.prod.yaml and Kubernetes)
IMAGE_TAG=

# Frontend Configuration
VITE_API_BASE_URL=/api
